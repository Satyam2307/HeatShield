# =============================================================================
# HeatShield: ShadeStop — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# Backend
ENVIRONMENT=development
DATA_MODE=fixture

# Database (optional — not needed for fixture mode)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/heatshield

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_DIR=./data/cache

# FortyGuard
FORTYGUARD_BASE_URL=
FORTYGUARD_API_KEY=

# Census / ACS
CENSUS_API_KEY=

# Mapping (frontend)
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAPTILER_KEY=

# Optional AI explanations
LLM_API_KEY=

# Monitoring
SENTRY_DSN=
